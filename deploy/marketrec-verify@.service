# Verify yesterday's recording of one symbol; started by marketrec-verify@.timer.
# The report goes to the journal: journalctl -u marketrec-verify@BTCUSDT
[Unit]
Description=marketrec: verify yesterday's recording of %i
Documentation=https://github.com/nathaniel-brodetsky/marketrec

[Service]
Type=oneshot
User=marketrec
Group=marketrec
ExecStart=/bin/sh -c 'exec /usr/local/bin/marketrec verify --day "/var/lib/marketrec/data/binance/%i/$(date -u -d yesterday +%%F)"'
Nice=10
IOSchedulingClass=idle

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadOnlyPaths=/var/lib/marketrec
PrivateTmp=yes
PrivateNetwork=yes
